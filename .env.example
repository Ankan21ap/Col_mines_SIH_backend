# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ────────────────────────────
# Get from Atlas → Connect → Drivers
MONGODB_ATLAS_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coalgov?retryWrites=true&w=majority



# ── File Storage (Cloudinary) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ── Map ──────────────────────────────────────────────────
# Leaflet + OpenStreetMap tiles need NO key by default.
MAP_API_KEY=

# ── AI (Groq) ────────────────────────────────────────────
# From console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

gemeni api kry = [GCP_API_KEY]

